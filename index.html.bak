        <div class="lesson-shell">
          <aside class="unit-nav">
            <h4>Unidades del tema</h4>
            <div class="unit-list">
              <button class="unit-btn active" data-unit="u1">1. Términos direccionales</button>
              <button class="unit-btn" data-unit="u2">2. Morfología externa</button>
