<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Anicura Campus ATV</title>
  <!-- SIMPLIFICADO: Eliminada la palabra Beta del título -->
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/main.css">

  <style id="atv-activities-styles">
    /* ── Flashcards RESPONSIVE FIX ──────────────── */
    .atv-flashcards { display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; }
    @media(max-width:900px){ .atv-flashcards{ grid-template-columns:repeat(2,1fr); } }
    @media(max-width:600px){ .atv-flashcards{ grid-template-columns:1fr; } }

    .atv-fc { perspective:800px; cursor:pointer; min-height:160px; }
    .atv-fc-in {
      position:relative; width:100%; height:100%; min-height:160px;
      transform-style:preserve-3d;
      transition:transform .45s cubic-bezier(.4,0,.2,1);
      border-radius:16px;
    }
    .atv-fc.atv-flipped .atv-fc-in { transform:rotateY(180deg); }
    .atv-face {
      position:absolute; inset:0; border-radius:16px;
      padding:1.25rem; backface-visibility:hidden;
      display:flex; flex-direction:column;
      justify-content:space-between;
      border:1.5px solid #E2EDF0;
      box-shadow:0 2px 8px rgba(0,60,80,.07);
    }
    .atv-front { background:#FFFFFF; }
    .atv-back  { background:#DDF0F4; transform:rotateY(180deg); }
    .atv-face span { font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.07em; color:#5A7A8A; }
    .atv-face strong { font-family:'Nunito',sans-serif; font-size:1rem; color:#1A3140; line-height:1.3; }
    .atv-face small { font-size:.72rem; color:#8EA8B5; margin-top:.25rem; }
    .atv-fc:hover .atv-fc-in { box-shadow:0 6px 20px rgba(0,60,80,.12); }

    /* ── Fill blanks ─────────────────────────── */
    .atv-blank {
      width:110px; padding:.3rem .6rem;
      border:2px solid #C8DDE3; border-radius:8px;
      background:#fff; text-align:center;
      font-size:.9rem; color:#1A3140;
      transition:border-color .2s, background .2s;
      vertical-align:middle;
    }
    .atv-blank:focus { outline:none; border-color:#7ABFB3; }
    .atv-blank.ok  { border-color:#2ECC71; background:#E6F7F2; }
    .atv-blank.bad { border-color:#E74C3C; background:#FDEEF0; }

    /* ── Exam questions ──────────────────────── */
    .atv-q { padding:1.25rem 0; border-bottom:1px dashed #E2EDF0; }
    .atv-q:last-child { border-bottom:none; }
    .atv-q-text {
      font-weight:600; color:#1A3140; margin:0 0 .85rem;
      font-size:.96rem; display:flex; gap:.6rem; align-items:flex-start;
    }
    .atv-qn {
      display:inline-flex; align-items:center; justify-content:center;
      width:24px; height:24px; border-radius:50%;
      background:#7ABFB3; color:#fff;
      font-size:.72rem; font-weight:800; flex-shrink:0; margin-top:.1rem;
    }
    .atv-opts { display:flex; flex-direction:column; gap:.5rem; }
    .atv-opt {
      display:flex; align-items:center; gap:.75rem;
      padding:.75rem 1rem; border-radius:12px;
      border:1.5px solid #E2EDF0; background:#F0F7F9;
      cursor:pointer; transition:all .15s;
      font-size:.9rem; color:#1A3140;
    }
    .atv-opt:hover { background:#DDF0F4; border-color:#B8DCE6; }
    .atv-opt input { accent-color:#7ABFB3; flex-shrink:0; width:16px; height:16px; }
    .atv-opt.correct { background:#D4F5E5; border-color:#2ECC71; color:#1A6B41; font-weight:600; }
    .atv-opt.wrong   { background:#FDEEF0; border-color:#E74C3C; color:#7B2D2D; }
  </style>
</head>
<body>
